// 大角牛快跑 —— 舞台（全局状态、计分、生成障碍、键盘与触屏控制、联网账号）

import (
	"bytes"
	"encoding/json"
	"net/http"
)

// 线上后端地址（唯一需要改的地方）。本地调试可以改成 "http://127.0.0.1:3000/api"
const apiBase = "https://bull.lingecho.com/api"

var (
	state      int     // 0 = 标题，1 = 游戏中，2 = 游戏结束
	score      int     // 分数（monitor 显示）
	coins      int     // 金币（monitor 显示）
	best       int     // 最高分（monitor 显示，本次会话内保留）
	boostLeft  int     // 冲刺剩余秒数（monitor 显示）
	newRecord  bool    // 本局是否刷新纪录
	bullLane   int     // 大角牛所在跑道：0 = 远（上），1 = 中，2 = 近（下）
	bullX      float64 // 大角牛的 x 坐标（固定）
	jumpH      float64 // 大角牛离地高度（> 0 表示在空中）
	sliding    bool    // 是否在滑铲
	speed      float64 // 基础速度（像素/帧），随时间变快
	curSpeed   float64 // 当前实际滚动速度（冲刺时更快）
	boostTime  float64 // 冲刺剩余帧数
	dist       float64 // 跑过的距离（换算成分数）
	frames     float64 // 本局已进行的帧数
	spawnGap   float64 // 距离下一排障碍还要跑多远
	overFrames int     // 游戏结束后经过的帧数（防止误触立刻重开）
	ptrDown    bool    // 鼠标 / 手指是否按下
	ptrSwiped  bool    // 这次按下是否已经算作一次滑动
	ptrX       float64 // 按下时的位置
	ptrY       float64
	shakeX     float64 // 冲刺时的画面抖动偏移（路面 / 大角牛 / 影子会加上它）
	shakeY     float64
	btnJumpT   int     // 屏幕按钮被按下后的高亮帧数
	btnSlideT  int
	// ---- v4：钱包 / 商店 / 复活 ----
	// 注意：spx v3.3.0 没有本地存储接口，下面这些只在本次打开游戏期间有效，刷新网页就清零
	wallet      int     // 钱包金币：每局结束把本局金币存进来，跨局累计
	charOwned   int     // 已拥有的角色（二进制位：1 = 大角牛，2 = 粉粉猪，4 = 咩咩羊）
	mapOwned    int     // 已拥有的地图（1 = 草原，2 = 沙漠，4 = 夜晚）
	curChar     int     // 当前角色 0 / 1 / 2
	curMap      int     // 当前地图 0 / 1 / 2
	shieldCnt   int     // 持有的无敌护盾（下一局开局自动带上 1 个）
	doubleCnt   int     // 持有的双倍金币卡（下一局开局自动用 1 张）
	runShield   int     // 本局还剩几次护盾（monitor 显示）
	coinMul     int     // 本局金币倍数 1 / 2（monitor 显示）
	shopSel     int     // 商店里键盘选中的卡片 0..7
	revived     bool    // 本局是否已经复活过
	frozen      bool    // 撞车后等待复活选择时，整个游戏暂停
	reviveMode  int     // 0 = 无，1 = 正在选择，2 = 正在看示意广告
	adT         int     // 示意广告剩余帧数
	invT        float64 // 无敌剩余帧数（复活 / 护盾之后）
	reviveClear int     // 复活瞬间清掉附近障碍（持续几帧）
	crashFxDone bool    // 撞车特效是否已经播过（复活选择时已播，放弃后不再重复）
	// ---- v5：联网账号（昵称 + 4 位 PIN），数据存在线上服务器 ----
	online    bool   // true = 已登录，钱包 / 解锁 / 最高分都以服务器为准
	token     string // 登录后的会话令牌
	runId     string // 服务器上这一局的编号
	adId      string // 示意广告编号（服务器要求看满 3 秒才能复活）
	netState  string // 右上角“账号”显示：在线 · 昵称 / 游客 / 离线
	loginNick string // 登录面板上的昵称
	loginPin  string // 输入中的 PIN（只在内存里）
	pinShow   string // PIN 显示成 ● ● _ _
	loginMsg  string // 登录面板上的提示
	nickIdx   int    // 预设昵称序号
	srvPrice  []any  // 服务器下发的价格（8 张卡片）
	netFails  int    // 连续网络失败次数
	netBusy   bool   // 正在等服务器回复（这时不接受新的联网操作）
	asking    bool   // 正在用输入框输入昵称（这时键盘不当快捷键用）
)

const reviveCost = 100

// 跑道 l 的地面 y 坐标（脚底位置）
func laneY(l int) float64 {
	return -62 - 50*float64(l)
}

// 跑道 l 上物体的缩放：近大远小
func laneScale(l int) float64 {
	return 0.86 + 0.07*float64(l)
}

func absf(v float64) float64 {
	if v < 0 {
		return -v
	}
	return v
}

func startGame() {
	if netBusy {
		return
	}
	score = 0
	coins = 0
	dist = 0
	frames = 0
	boostTime = 0
	boostLeft = 0
	newRecord = false
	bullLane = 1
	jumpH = 0
	sliding = false
	speed = 4.5
	curSpeed = speed
	spawnGap = 200
	revived = false
	frozen = false
	reviveMode = 0
	invT = 0
	reviveClear = 0
	crashFxDone = false
	hideVar "boostLeft"
	hideVar "wallet"
	setBackdrop curMap
	// 道具：开局自动使用（每样每局最多 1 个）
	runShield = 0
	hideVar "runShield"
	coinMul = 1
	hideVar "coinMul"
	runId = ""
	started := false
	if online {
		r := api("/xb/start", {})
		if r == nil {
			if !netFail() {
				return // 网络抖了一下：先不开局，提示玩家再按一次
			}
		} else if ok(r) {
			started = true
			runId = str(r, "run")
			applyProfile(r)
			runShield = num(r, "run_shield")
			coinMul = 1 + num(r, "run_double")
		} else {
			goOffline(str(r, "err"))
		}
	}
	if !started {
		if shieldCnt > 0 {
			shieldCnt--
			runShield = 1
		}
		if doubleCnt > 0 {
			doubleCnt--
			coinMul = 2
		}
	}
	if runShield > 0 {
		showVar "runShield"
	}
	if coinMul > 1 {
		showVar "coinMul"
	}
	Panel.hide
	play "bgm", true // 背景音乐循环播放
	NewRecord.hide
	Bull.reset
	state = 1
}

func gameOver() {
	if state != 1 {
		return
	}
	state = 2
	frozen = false
	reviveMode = 0
	overFrames = 0
	curSpeed = 0
	boostTime = 0
	hideVar "boostLeft"
	hideVar "runShield"
	hideVar "coinMul"
	score = int(dist) + coins*10
	showVar "wallet"
	finished := false
	if online && runId != "" {
		// 联网：成绩交给服务器结算（服务器按真实时长防作弊、发金币、记最高分和排名）
		r := api("/xb/finish", {"run": runId, "score": score, "coins": coins / coinMul})
		if r == nil {
			r = api("/xb/finish", {"run": runId, "score": score, "coins": coins / coinMul}) // 成绩很重要：再试一次
		}
		if r == nil {
			goOffline("网络出错")
		} else if ok(r) {
			finished = true
			newRecord = r["new_record"] == true
			applyProfile(r)
			netState = "在线 · " + str(r, "nick") + " · 全服第 " + itoa(num(r, "rank")) + " 名"
		} else {
			goOffline(str(r, "err"))
		}
		runId = ""
	}
	if !finished {
		wallet += coins // 离线：本局金币存进钱包（只在本次打开期间有效）
		if score > best {
			best = score
			newRecord = true
		}
	}
	stopPlaying "bgm"
	if !crashFxDone {
		crashFx()
	}
	Bull.crash
	Panel.showOver
	if newRecord {
		NewRecord.pop
	}
}

// 撞车音效 + 白闪 + 火花
func crashFx() {
	crashFxDone = true
	play "crash"
	Flash.flash
	for i := 0; i < 12; i++ {
		spawnFx(1, bullX+15, Bull.ypos+30, rand(-4.5, 4.5), rand(1.5, 7.0))
	}
}

// 障碍撞到大角牛时调用。返回 true 表示被护盾挡住（障碍被撞飞、继续跑）
func onHit() bool {
	if runShield > 0 {
		runShield--
		if runShield == 0 {
			hideVar "runShield"
		}
		invT = 60
		play "boost"
		Toast.pop 4
		return true
	}
	if !revived {
		offerRevive()
	} else {
		gameOver() // 已经复活过一次：第二次撞车直接结束
	}
	return false
}

// 弹出复活选择：暂停游戏
func offerRevive() {
	frozen = true
	curSpeed = 0
	reviveMode = 1
	pausePlaying "bgm"
	crashFx()
	Bull.crash
	Revive.showOffer
}

// 复活选择：1 = 花金币，2 = 看示意广告，3 = 放弃
func reviveChoose(k int) {
	if netBusy {
		return
	}
	if state != 1 || reviveMode != 1 {
		return
	}
	if k == 1 {
		if online {
			r := api("/xb/revive", {"run": runId, "method": "coins"})
			if r == nil {
				if !netFail() {
					return // 还停在复活面板，可以再点一次
				}
			} else if ok(r) {
				applyProfile(r)
				doRevive()
				return
			} else {
				Toast.pop 0
				return
			}
		}
		if wallet >= reviveCost {
			wallet -= reviveCost
			doRevive()
		} else {
			Toast.pop 0
		}
	} else if k == 2 {
		if online {
			r := api("/xb/ad", {"run": runId})
			adId = ""
			if r == nil {
				netFail()
			} else {
				adId = str(r, "ad")
			}
		}
		reviveMode = 2
		adT = 180 // 3 秒（60 帧/秒）
	} else {
		reviveMode = 0
		Revive.hide
		gameOver()
	}
}

func doRevive() {
	reviveMode = 0
	Revive.hide
	revived = true
	frozen = false
	crashFxDone = false
	invT = 120 // 无敌 2 秒
	reviveClear = 3
	Bull.say ""
	resumePlaying "bgm"
	Toast.pop 5
}

// ---------------- 联网 ----------------
// 发一个 POST 请求，返回服务器的 JSON（map）。连不上 / 超时 / 返回不是 JSON 时返回 nil。
// （解释器里没有 io.ReadAll，所以用 json.NewDecoder 直接读响应体）
// 令牌放在 body 里（不用自定义请求头），这样浏览器跨域时只需要服务器放行 Content-Type。
// 登录类请求连接失败时自动重试 1 次（公网偶尔握手失败）。
// apiSync 真正发请求（会阻塞），只能在后台 goroutine 里调用。
func apiSync(path string, b []byte) map[string]any {
	var resp *http.Response
	tries := 1
	if path == "/xb/login" || path == "/xb/profile" || path == "/xb/top" {
		tries = 2 // 只有重复发也没副作用的请求才自动重试（买东西等不重试，免得扣两次）
	}
	for try := 0; try < tries; try++ {
		req, err := http.NewRequest("POST", apiBase+path, bytes.NewReader(b))
		if err != nil {
			return nil
		}
		req.Header.Set("Content-Type", "application/json")
		r, err := http.DefaultClient.Do(req)
		if err == nil {
			println "[bull] 响应状态:", path, r.StatusCode
			resp = r
			break
		}
		println "[bull] 网络错误:", path, err
	}
	if resp == nil {
		return nil
	}
	defer resp.Body.Close()
	var out map[string]any
	if err := json.NewDecoder(resp.Body).Decode(&out); err != nil {
		println "[bull] 解析 JSON 失败:", path, err
		return nil
	}
	println "[bull] 解析成功:", path, "ok =", out["ok"], "err =", out["err"]
	return out
}

// api 发一个请求并等结果，但**不卡住引擎**：
// 浏览器（XBuilder 网页）里 Go 跑在 wasm 上，net/http 要等浏览器的 fetch 完成；
// 如果在脚本协程里直接阻塞等待，引擎这一帧永远结束不了，fetch 也就永远回不来 → 画面卡死 / 变白。
// 所以请求放到后台 goroutine 里做，当前脚本每帧 waitNextFrame 让出，直到结果到达。
func api(path string, body map[string]any) map[string]any {
	if token != "" {
		body["token"] = token
	}
	b, _ := json.Marshal(body)
	ch := make(chan map[string]any, 1)
	netBusy = true
	go func() {
		var r map[string]any
		defer func() {
			if e := recover(); e != nil {
				println "[bull] 请求 panic（已拦截）:", path, e // 出错也不能让整个游戏崩掉
			}
			ch <- r // 缓冲为 1，不会阻塞
		}()
		println "[bull] 请求开始:", path
		r = apiSync(path, b)
	}()
	var out map[string]any
	waiting := true
	for waiting {
		select {
		case out = <-ch:
			waiting = false
		default:
			waitNextFrame
		}
	}
	if out == nil {
		println "[bull] 请求结束（失败）:", path
	} else {
		println "[bull] 请求结束，结果已交给游戏:", path
	}
	netBusy = false
	if out != nil {
		netFails = 0
	}
	return out
}

// 一次网络失败：第 1 次只提示“网络不稳，请再试一次”，连续第 2 次就转为离线。返回 true 表示已经离线
func netFail() bool {
	netFails++
	if netFails >= 2 {
		goOffline("网络出错")
		return true
	}
	Toast.pop 10
	return false
}

func ok(r map[string]any) bool {
	return r != nil && r["ok"] == true
}

func num(r map[string]any, k string) int {
	if v, isNum := r[k].(float64); isNum {
		return int(v)
	}
	return 0
}

func str(r map[string]any, k string) string {
	if v, isStr := r[k].(string); isStr {
		return v
	}
	return ""
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	s := ""
	neg := n < 0
	if neg {
		n = -n
	}
	for n > 0 {
		s = string(rune('0'+n%10)) + s
		n /= 10
	}
	if neg {
		s = "-" + s
	}
	return s
}

// 用服务器返回的数据刷新本地状态
func applyProfile(r map[string]any) {
	wallet = num(r, "wallet")
	best = num(r, "best")
	charOwned = num(r, "chars") | 1
	mapOwned = num(r, "maps") | 1
	curChar = num(r, "char")
	curMap = num(r, "map")
	shieldCnt = num(r, "shield")
	doubleCnt = num(r, "double")
	if shieldCnt > 3 {
		shieldCnt = 3
	}
	if doubleCnt > 3 {
		doubleCnt = 3
	}
	if p, isList := r["prices"].([]any); isList && len(p) == 8 {
		srvPrice = p
	}
	setBackdrop curMap
}

// 网络出问题：切到离线（游客）模式，当前钱包等数据保留在本次会话里
func goOffline(why string) {
	if online {
		Toast.pop 7
	}
	online = false
	token = ""
	runId = ""
	netFails = 0
	netState = "离线（" + why + "）"
}

// 示意广告倒计时结束
func adDone() {
	if online && adId != "" {
		r := api("/xb/revive", {"run": runId, "method": "ad", "ad": adId})
		adId = ""
		if r == nil {
			netFail()
		} else if ok(r) {
			applyProfile(r)
		} else {
			goOffline(str(r, "err"))
		}
	}
	doRevive()
}

// ---------------- 登录面板（state 5） ----------------
func presetNick(i int) string {
	switch i % 8 {
	case 1:
		return "草原小飞牛"
	case 2:
		return "沙漠骆驼迷"
	case 3:
		return "星空夜跑者"
	case 4:
		return "金币收割机"
	case 5:
		return "跑酷小王子"
	case 6:
		return "牛气冲天"
	case 7:
		return "一路狂奔"
	}
	return "快跑大角牛"
}

func updatePin() {
	pinShow = ""
	for i := 0; i < 4; i++ {
		if i < len(loginPin) {
			pinShow += "* "
		} else {
			pinShow += "_ "
		}
	}
}

func openLogin() {
	if state != 0 && state != 2 && state != 5 {
		return
	}
	state = 5
	Panel.hide
	NewRecord.hide
	Bull.say ""
	if loginNick == "" {
		loginNick = presetNick(0)
	}
	loginPin = ""
	updatePin()
	loginMsg = "选好昵称、输入 PIN，然后 登录 或 注册"
	Login.open
	hideVar "netState"
	showVar "loginNick"
	showVar "pinShow"
	showVar "loginMsg"
}

func closeLogin() {
	hideVar "loginNick"
	hideVar "pinShow"
	hideVar "loginMsg"
	Login.hide
	showVar "netState"
	state = 0
	Panel.showTitle
}

func pinKey(d int) {
	if state != 5 || asking {
		return
	}
	if d == -1 {
		if len(loginPin) > 0 {
			loginPin = loginPin[:len(loginPin)-1]
		}
	} else if d == -2 {
		loginPin = ""
	} else if len(loginPin) < 4 {
		loginPin += string(rune('0' + d))
	}
	updatePin()
}

func nextNick(d int) {
	if state != 5 || asking {
		return
	}
	nickIdx = (nickIdx + d + 8) % 8
	loginNick = presetNick(nickIdx)
}

// 用 spx 的 ask 弹出输入框自己输入昵称
func typeNick() {
	if state != 5 || asking {
		return
	}
	asking = true
	ask "请输入昵称（1-16 个字，换设备时用它登录）"
	a := answer
	wait 0.4 // 等输入框的回车键过去，免得被当成“登录”
	asking = false
	if len(a) > 0 {
		r := []rune(a)
		if len(r) > 16 {
			r = r[:16]
		}
		loginNick = string(r)
	}
}

// 登录（reg = false）或注册（reg = true）
func doLogin(reg bool) {
	if state != 5 || asking || netBusy {
		return
	}
	if len(loginPin) != 4 {
		loginMsg = "PIN 要输满 4 位数字"
		return
	}
	loginMsg = "连接服务器中……"
	path := "/xb/login"
	if reg {
		path = "/xb/register"
	}
	token = ""
	r := api(path, {"nick": loginNick, "pin": loginPin})
	if r == nil {
		loginMsg = "连不上服务器，可以先选「游客试玩」"
		return
	}
	if !ok(r) {
		loginMsg = str(r, "err")
		return
	}
	token = str(r, "token")
	online = true
	applyProfile(r)
	netState = "在线 · " + str(r, "nick")
	loginPin = ""
	closeLogin()
	if reg {
		Toast.pop 8
	} else {
		Toast.pop 9
	}
}

// 游客试玩：不联网，数据只在本次打开期间有效
func guestMode() {
	if state != 5 || asking || netBusy {
		return
	}
	online = false
	token = ""
	netState = "游客（不存档）"
	wallet = 0
	charOwned = 1
	mapOwned = 1
	curChar = 0
	curMap = 0
	shieldCnt = 0
	doubleCnt = 0
	best = 0
	srvPrice = nil
	setBackdrop 0
	closeLogin()
}

// 登录面板上的点击（面板中心在舞台 (0, -5)，左上角在 (-220, 154)）
func loginClick(x, y float64) {
	if asking {
		return
	}
	px := x + 220
	py := 154 - y
	if absf(py-104) < 15 {
		if absf(px-30) < 18 {
			nextNick(-1)
			return
		} else if absf(px-78) < 18 {
			nextNick(1)
			return
		} else if absf(px-150) < 49 {
			typeNick()
			return
		}
	}
	if absf(px-110) < 96 {
		if absf(py-206) < 17 {
			doLogin(false)
			return
		} else if absf(py-246) < 16 {
			doLogin(true)
			return
		} else if absf(py-284) < 15 {
			guestMode()
			return
		}
	}
	for k := 0; k < 12; k++ {
		cx := 270 + 60*float64(k%3)
		cy := 72 + 44*float64(k/3)
		if absf(px-cx) < 27 && absf(py-cy) < 20 {
			if k < 9 {
				pinKey(k + 1)
			} else if k == 9 {
				pinKey(-2)
			} else if k == 10 {
				pinKey(0)
			} else {
				pinKey(-1)
			}
			return
		}
	}
}

// ---------------- 商店 ----------------
func price(i int) int {
	if len(srvPrice) == 8 {
		if v, isNum := srvPrice[i].(float64); isNum {
			return int(v)
		}
	}
	switch i {
	case 1:
		return 300
	case 2:
		return 600
	case 4:
		return 200
	case 5:
		return 500
	case 6:
		return 60
	case 7:
		return 80
	}
	return 0
}

func cardX(i int) float64 {
	return -165 + 110*float64(i%4)
}

func cardY(i int) float64 {
	if i < 4 {
		return 40
	}
	return -80
}

func openShop() {
	if state != 0 && state != 2 {
		return
	}
	state = 3
	Panel.hide
	NewRecord.hide
	Bull.say "" // 收起撞车时的“哎呀！”气泡
	showVar "wallet"
	Shop.open
	for i := 0; i < 8; i++ {
		ShopCard.clone i
	}
}

func closeShop() {
	if state != 3 {
		return
	}
	state = 0
	Shop.hide
	Panel.showTitle
}

func shopMove(d int) {
	n := shopSel + d
	if n >= 0 && n <= 7 {
		shopSel = n
	}
}

// 买下或使用第 i 个商品：0-2 角色，3-5 地图，6 无敌护盾，7 双倍金币
func buyOrUse(i int) {
	if netBusy {
		return
	}
	if online {
		r := api("/xb/buy", {"item": i})
		if r == nil {
			if !netFail() {
				return // 网络抖了一下：这次没买，提示再点一次
			}
			// 连续失败已转为离线：下面按离线规则处理
		} else if ok(r) {
			applyProfile(r)
			if r["bought"] == true {
				play "coin"
				Toast.pop 1
			} else {
				Toast.pop 2
			}
			return
		} else {
			if num(r, "code") == 409 {
				Toast.pop 3
			} else if num(r, "code") == 402 {
				Toast.pop 0
			} else {
				goOffline(str(r, "err"))
			}
			return
		}
	}
	p := price(i)
	if i < 6 {
		bit := 1 << uint(i%3)
		owned := charOwned
		if i >= 3 {
			owned = mapOwned
		}
		if owned&bit == 0 {
			if wallet < p {
				Toast.pop 0
				return
			}
			wallet -= p
			if i < 3 {
				charOwned |= bit
			} else {
				mapOwned |= bit
			}
			play "coin"
			Toast.pop 1
		} else {
			Toast.pop 2
		}
		if i < 3 {
			curChar = i
		} else {
			curMap = i - 3
			setBackdrop curMap
		}
		return
	}
	cnt := shieldCnt
	if i == 7 {
		cnt = doubleCnt
	}
	if cnt >= 3 {
		Toast.pop 3
		return
	}
	if wallet < p {
		Toast.pop 0
		return
	}
	wallet -= p
	if i == 6 {
		shieldCnt++
	} else {
		doubleCnt++
	}
	play "coin"
	Toast.pop 1
}

func startBoost() {
	boostTime = 300 // 约 5 秒（60 帧/秒）
	boostLeft = 5
	showVar "boostLeft"
	play "boost"
}

func addCoin() {
	coins++
}

// 在 (x, y) 收集到一枚金币：加分 + 叮的一声 + “+10”飘字
func addCoinAt(x, y float64) {
	coins += coinMul
	play "coin"
	if coinMul == 2 {
		spawnFx(3, x+8, y+34, 0, 2.2) // 双倍金币：飘“+20”
	} else {
		spawnFx(0, x+8, y+34, 0, 2.2)
	}
}

// 生成一个特效克隆，k：0 = +10，1 = 火花，2 = 扬尘
func spawnFx(k int, x, y, vx, vy float64) {
	Fx.clone([]float64{float64(k), x, y, vx, vy})
}

// 手指按下时是否落在屏幕按钮上（按钮半径约 29，判定放宽到 36）
func inButton(bx, by float64) bool {
	dx := mouseX - bx
	dy := mouseY - by
	return dx*dx+dy*dy < 36*36
}

// 点击 / 空格：开始或重新开始
func tap() {
	if state == 0 {
		startGame()
	} else if state == 2 && overFrames > 40 {
		startGame()
	}
}

func doJump() {
	if state == 1 {
		if frozen {
			return
		}
		Bull.doJump
	} else {
		tap()
	}
}

func doSlide() {
	if state == 1 && !frozen {
		Bull.doSlide
	}
}

func changeLane(d int) {
	if state != 1 || frozen {
		return
	}
	l := bullLane + d
	if l >= 0 && l <= 2 {
		bullLane = l
	}
}

// 触屏 / 鼠标：自己检测“点一下”和“滑动”。
//   上滑 / 下滑：换到上面（远）/ 下面（近）的跑道
//   点右半屏：跳跃；点左半屏：滑铲；不在游戏中时点哪里都是开始 / 重新开始
//   右下角「跳」/ 左下角「滑」按钮：按下立刻生效（v3）
// （没有用 onSwipe：本地实测 spx v3.3.0 的上下滑动方向是反的，所以直接读 mouseX / mouseY 判断）
func pollPointer() {
	if mousePressed {
		if !ptrDown {
			ptrDown = true
			ptrSwiped = false
			ptrX = mouseX
			ptrY = mouseY
			if state == 1 && !frozen {
				// 屏幕按钮：按下瞬间就触发，并把这次按下“用掉”，松手时不会再按左右半屏重复触发
				if inButton(208, -148) {
					ptrSwiped = true
					btnJumpT = 8
					doJump()
				} else if inButton(-208, -148) {
					ptrSwiped = true
					btnSlideT = 8
					doSlide()
				}
			}
		} else if !ptrSwiped {
			dx := mouseX - ptrX
			dy := mouseY - ptrY
			if absf(dy) > 25 && absf(dy) >= absf(dx) {
				ptrSwiped = true
				if dy > 0 {
					changeLane(-1) // 向上滑：换到上面（远）一道
				} else {
					changeLane(1) // 向下滑：换到下面（近）一道
				}
			} else if absf(dx) > 25 {
				ptrSwiped = true // 左右滑动不做任何事
			}
		}
	} else {
		if ptrDown && !ptrSwiped {
			if state == 5 {
				loginClick(ptrX, ptrY)
			} else if state == 3 {
				shopClick(ptrX, ptrY)
			} else if state == 1 && frozen {
				reviveClick(ptrX, ptrY)
			} else if state != 1 {
				if absf(ptrX-92) < 44 && absf(ptrY+152) < 17 {
					openLogin() // 点「账号」按钮
				} else if absf(ptrX-190) < 44 && absf(ptrY+152) < 17 {
					openShop() // 点右下角「商店」按钮
				} else {
					tap() // 开始 / 重新开始
				}
			} else if ptrX >= 0 {
				doJump() // 点右半屏：跳
			} else {
				doSlide() // 点左半屏：滑铲
			}
		}
		ptrDown = false
	}
}

// 商店里点击：点卡片 = 购买 / 使用，点「返回」= 回到标题
func shopClick(x, y float64) {
	if absf(x-195) < 31 && absf(y-128) < 14 {
		closeShop()
		return
	}
	for i := 0; i < 8; i++ {
		if absf(x-cardX(i)) < 51 && absf(y-cardY(i)) < 57 {
			shopSel = i
			buyOrUse(i)
			return
		}
	}
}

// 复活面板里点击（面板在舞台中央）
func reviveClick(x, y float64) {
	if reviveMode != 1 {
		return
	}
	if absf(x) < 119 && absf(y-25) < 18 {
		reviveChoose(1)
	} else if absf(x) < 119 && absf(y+23) < 18 {
		reviveChoose(2)
	} else if absf(x) < 59 && absf(y+70) < 15 {
		reviveChoose(3)
	}
}

// 生成一个障碍物：低栏 / 高栏要同时生成后层和前层两个克隆
func spawnObstacle(l int, k int) {
	Obstacle.clone l + 10*k
	if k == 0 || k == 2 {
		Obstacle.clone l + 10*k + 100
	}
}

// 按躲法随机挑一种障碍：0 = 跳（低栏 / 石堆），1 = 滑铲（高栏），2 = 换道（草垛 / 木箱）
func pickKind(cat int) int {
	if cat == 0 {
		return int(rand(0, 1))
	} else if cat == 1 {
		return 2
	}
	return 3 + int(rand(0, 1))
}

// 生成一排障碍物（以及金币 / 冲刺道具）
func spawnRow() {
	n := 1
	if frames > 900 && rand(1, 100) <= 45 {
		n = 2
	}
	l1 := int(rand(0, 2))
	c1 := int(rand(0, 2))
	spawnObstacle(l1, pickKind(c1))
	used2 := -1
	if n == 2 {
		l2 := (l1 + 1 + int(rand(0, 1))) % 3
		c2 := int(rand(0, 2))
		if c1 == 2 && c2 == 2 {
			c2 = int(rand(0, 1)) // 至少留一条能跳 / 滑过去的路
		}
		spawnObstacle(l2, pickKind(c2))
		used2 = l2
	}
	free := 0
	for free == l1 || free == used2 {
		free++
	}
	r := rand(1, 100)
	if r <= 8 && boostTime == 0 {
		Boost.clone free
	} else if r <= 70 {
		for i := 0; i < 5; i++ {
			Coin.clone i*10 + free
		}
	}
}

onStart => {
	state = 0
	best = 0
	bullX = -150
	bullLane = 1
	curSpeed = 2
	wallet = 0
	charOwned = 1
	mapOwned = 1
	curChar = 0
	curMap = 0
	hideVar "boostLeft"
	hideVar "runShield"
	hideVar "coinMul"
	showVar "wallet"
	http.DefaultClient.Timeout = 4000000000 // 每次网络请求最多等 4 秒（单位纳秒）
	netState = "游客（不存档）"
	state = 0
	openLogin() // 一打开先显示登录面板（可以选游客试玩）
	for {
		if state == 1 && frozen {
			curSpeed = 0
			if reviveMode == 2 {
				adT--
				if adT <= 0 {
					adDone() // 示意广告看完：复活
				}
			}
		} else if state == 1 {
			if invT > 0 {
				invT--
			}
			if reviveClear > 0 {
				reviveClear--
			}
			frames++
			speed = 4.5 + frames*0.0025
			if speed > 11 {
				speed = 11
			}
			if boostTime > 0 {
				boostTime--
				curSpeed = speed * 1.6
				boostLeft = int(boostTime/60) + 1
				if boostTime <= 0 {
					boostLeft = 0
					hideVar "boostLeft"
				}
			} else {
				curSpeed = speed
			}
			if boostTime > 0 {
				shakeX = rand(-1.6, 1.6)
				shakeY = rand(-1.6, 1.6)
			} else {
				shakeX = 0
				shakeY = 0
			}
			dist += curSpeed / 20
			score = int(dist) + coins*10
			spawnGap -= curSpeed
			if spawnGap <= 0 {
				spawnRow()
				gap := rand(230.0, 360.0) - frames*0.02
				if gap < 170 {
					gap = 170
				}
				spawnGap = gap
			}
		} else if state == 0 {
			curSpeed = 2
		} else {
			curSpeed = 0
			shakeX = 0
			shakeY = 0
			overFrames++
		}
		pollPointer()
		waitNextFrame
	}
}

// 键盘：J 跳跃，K 滑铲，↑/W 换到上面（远）一道，↓/S 换到下面（近）一道
// 空格：游戏中也能跳；空格 / 回车：开始 / 重新开始
// 登录面板：数字键输 PIN，Backspace 删除，←→ 换昵称，T 输入昵称，回车 登录，R 注册，G 游客
onKey [Key0, Key1, Key2, Key3, Key4, Key5, Key6, Key7, Key8, Key9], key => {
	if state == 5 {
		pinKey(int(key) - int(Key0))
	}
}

onKey KeyBackspace, => {
	pinKey(-1)
}

onKey KeyT, => {
	typeNick()
}

onKey KeyR, => {
	doLogin(true)
}

onKey KeyG, => {
	guestMode()
}

onKey KeyL, => {
	if state == 0 || state == 2 {
		openLogin()
	}
}

onKey [KeyJ, KeySpace], => {
	if state == 3 {
		buyOrUse(shopSel)
	} else {
		doJump()
	}
}

onKey KeyK, => {
	doSlide()
}

onKey [KeyUp, KeyW], => {
	if state == 3 {
		shopMove(-4)
	} else {
		changeLane(-1)
	}
}

onKey [KeyDown, KeyS], => {
	if state == 3 {
		shopMove(4)
	} else {
		changeLane(1)
	}
}

onKey [KeyLeft, KeyA], => {
	if state == 5 {
		nextNick(-1)
	} else if state == 3 {
		shopMove(-1)
	}
}

onKey [KeyRight, KeyD], => {
	if state == 5 {
		nextNick(1)
	} else if state == 3 {
		shopMove(1)
	}
}

onKey KeyEnter, => {
	if state == 5 {
		doLogin(false)
	} else if state == 3 {
		buyOrUse(shopSel)
	} else {
		tap()
	}
}

// B：打开 / 关闭商店（标题页和结算页都能开）；Esc：关闭商店，或在复活选择时放弃
onKey KeyB, => {
	if state == 3 {
		closeShop()
	} else {
		openShop()
	}
}

onKey KeyEscape, => {
	if state == 5 {
		guestMode()
	} else if state == 3 {
		closeShop()
	} else {
		reviveChoose(3)
	}
}

// 复活选择：1 花金币，2 看示意广告，3 放弃
onKey Key1, => {
	reviveChoose(1)
}

onKey Key2, => {
	reviveChoose(2)
}

onKey Key3, => {
	reviveChoose(3)
}
