# 复制成 deploy/env 再改密码：cp deploy/env.example deploy/env && chmod 600 deploy/env
HOST=127.0.0.1
PORT=3000
DB_URL=mysql://bull:换成强密码@127.0.0.1:3306/running_bull
PUBLIC_URL=https://bull.lingecho.com
TRUST_PROXY=1
QUIET=1

# 微信公众号网页授权。竖屏页已经不用它登录（打开页面即用设备号）。
# 两条都不填时这些接口保持关闭。不要把 AppSecret 提交到 git。
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# 必须和公众平台里配置的授权回调地址一致，默认是 PUBLIC_URL + /api/wechat/callback
# WECHAT_REDIRECT_URI=https://bull.lingecho.com/api/wechat/callback
# 默认 snsapi_userinfo（要昵称和头像）。未认证公众号如果拉不起用户信息，改成 snsapi_base（只有 openid）。
# WECHAT_OAUTH_SCOPE=snsapi_userinfo
